{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "workspaceConfig"],
    "workspaceConfig": ["{workspaceRoot}/tsconfig.json", "{workspaceRoot}/pnpm-lock.yaml"]
  },
  "sync": {
    "disabledTaskSyncGenerators": ["@nx/js:typescript-sync"]
  },
  "release": {
    "projects": ["web", "api", "chat"],
    "projectsRelationship": "fixed",
    "releaseTag": {
      "pattern": "v{version}"
    },
    "version": {
      "conventionalCommits": true,
      "preVersionCommand": "node tools/check-release.mjs"
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": false,
        "renderOptions": {
          "applyUsernameToAuthors": false
        }
      }
    }
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "include": ["apps/**/*", "packages/**/*"]
    },
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "build": {
          "configName": "tsconfig.build.json",
          "skipBuildCheck": true
        }
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "include": ["apps/web/**/*"]
    },
    {
      "plugin": "@nx/vitest",
      "include": ["apps/api/**/*"],
      "options": {
        "testMode": "run"
      }
    }
  ]
}
