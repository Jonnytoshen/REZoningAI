{
  "name": "@rezoning-ai/api",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.93",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@rezoning-ai/chat": "workspace:*",
    "ai": "^7.0.176",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.0.0"
  },
  "nx": {
    "name": "api",
    "targets": {
      "dev": {
        "command": "node --env-file-if-exists=.env --watch --conditions=rezoning-source --import tsx apps/api/src/main.ts",
        "continuous": true,
        "cache": false
      },
      "build": {
        "inputs": [
          "...",
          "^default"
        ]
      }
    }
  }
}
