{
  "name": "rezoning-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "nx run-many -t dev -p api web --parallel=2",
    "dev:api": "nx dev api",
    "dev:web": "nx dev web",
    "build": "nx run-many -t build -p api web",
    "start": "node --env-file-if-exists=.env apps/api/dist/main.js",
    "test": "node --conditions=rezoning-source --import tsx --test apps/api/test/*.test.ts"
  },
  "devDependencies": {
    "@nx/js": "24.0.6",
    "@nx/vite": "24.0.6",
    "@nx/web": "24.0.6",
    "nx": "24.0.6",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
