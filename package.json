{
  "name": "rezoning-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch --import tsx apps/api/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc -p apps/api/tsconfig.json && tsc -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/api/apps/api/src/main.js",
    "test": "node --import tsx --test apps/api/test/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.93",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "ai": "^7.0.176",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
